{
    "extends": "astro/tsconfigs/strictest",
    "include": [
        ".astro/types.d.ts",
        "**/*"
    ],
    "exclude": [
        "dist",
        "babashka-legacy",
        "public/legacy"
    ],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "baseUrl": ".",
        "paths": {
            "@components/*": ["astro-reveal/src/components/*"],
            "@layouts/*": ["astro-reveal/src/layouts/*"],
            "@styles/*": ["astro-reveal/src/styles/*"],
            "@slide-blocks/*": ["src/slide-blocks/*"]
        }
    }
}
