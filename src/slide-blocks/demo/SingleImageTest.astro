---
import Slide from "../../components/Slide.astro"
import { Image } from 'astro:assets'
import CentredImage from "../../components/CentredImage.astro"
import img1 from "./img/kal-1.png"
---
<Slide t1="Single Image (Direct)">
	<div class="flex justify-center items-center">
        <Image
            src={ img1 }
            alt="Unity Tag Menu"
            height="300"
            width="300" />
    </div>
</Slide>

<Slide t1="Single Image (Component)">
    <CentredImage
        src={ img1 }
        alt="Unity Tag Menu"
        size={ [300] }/>
</Slide>
