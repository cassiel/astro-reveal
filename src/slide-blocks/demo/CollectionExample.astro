---
import Slide from "../../components/Slide.astro"
import { getCollection } from "astro:content"

const legacy_old = await (async () => {
    const d = await getCollection("legacy_old")

    if (d[0]) {
        return d[0].data
    } else {
        return []
    }
})()

const legacy = await getCollection("legacy")
---
<Slide>
    <h3>Collection Example (JSON - messy)</h3>

    <pre>{ JSON.stringify(legacy_old) }</pre>

    <table style={{ "font-size": "0.7em" }}>
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>

        <!--
            A bit of a mess, partly in order to get a workable schema (so we
            really want statically-determined keys), and also the JSON importer
            seems to want to return an array: a list
            of items, one per unit, and each maps to a list of file * title.
            So to get a specific unit, we filter down first.
        -->

        <tbody>
            {
                legacy_old.filter(x => (x.unit === "iu000166_fp1")).map(p => (
                    p.presentations.map(({ file, title }) => <tr>
                        <td>{ file }</td>
                        <td>{ title }</td>
                    </tr>)
                ))
            }
        </tbody>
    </table>
</Slide>

<Slide>
    <h3>Collection Example (YAML - neater)</h3>

    <!--
        This seems a bit more in line with how collections seem to work.
        I still want a schema with a map from enums to records, but that is
        proving elusive.
    -->

    <pre>{ JSON.stringify(legacy) }</pre>

    <table style={{ "font-size": "0.7em" }}>
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>

        <tbody>
            {
                legacy.filter(x => (x.id === "iu000166_fp1")).map(p => (
                    p.data.map(({ file, title }) => <tr>
                        <td>{ file }</td>
                        <td>{ title }</td>
                    </tr>)
                ))
            }
        </tbody>
    </table>
</Slide>
