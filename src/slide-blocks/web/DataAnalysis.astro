---
import Slide from "../../components/Slide.astro"
import CodeBlock from "../../components/CodeBlock.astro"
import { Image } from 'astro:assets'
import donut_final from "../../img/web/donut-final.png"
---
<Slide t1="Curated Data Kick-off" t2="Round Trip in Flask">
    <ol>
        <li class="fragment">Test this in the notebook</li>
        <li class="fragment">Test this in the browser</li>
    </ol>
    
    <div class="fragment text-sm-2">
        <CodeBlock lang="python" height="100px">
            { `
import pandas as pd
# Load the data:
UPLOADED_DATA = pd.read_csv("Synthetic_Digital_Traces_Dataset.csv")
`.trim()
            }
        </CodeBlock>

        <CodeBlock lang="python" height="100px">
            { `
# Examine the data in the notebook:
UPLOADED_DATA.head()
`.trim()
            }
        </CodeBlock>

        <CodeBlock lang="python" height="175px">
            { `
# Serve the data out from Flask:
@app.route("/all-data")
@cross_origin(origin="*")
def data_analysis():
        output = io.StringIO()
        UPLOADED_DATA.to_csv(output, index=False)
        return output.getvalue()
`.trim()
            }
        </CodeBlock>
    </div>
</Slide>

<Slide t2="React: Show The Table">
    <ul>
        <li>We use D3 to fetch the CSV data</li>
        <li>We use React to alter the DOM to show the data</li>
    </ul>

    <div class="text-sm-2">
        <CodeBlock lang="javascript" height="250px">
            { `
export default function DataAnalysisTable() {
    const [state, setState] = useState([])      // List of records
    
    useEffect(() => {
        d3.csv("http://localhost:5050/all-data").then(data => {
            console.log(data)
            setState(data)
        })
    }, [])

    ....
            `.trim() }
        </CodeBlock>
    </div>
</Slide>

<Slide t2="Astro Props">
    <ul class="text-sm-2">
        <li>Advanced aside: we've actually modified the component to take a variable
            <code>endpoint</code> (a different API URL)</li>
    </ul>

    <div class="text-sm-2">
        <CodeBlock  lang="javascript" lines="*|1,8" height="300px">
            { `
export default function DataAnalysisTable({ endpoint }) {
    const [state, setState] = useState([])      // List of records
    
    // This is a bit of a mix: we've used D3 to fetch and
    // parse the CSV data (returning a sequence of objects),
    // then we swap it into React.
    useEffect(() => {
        d3.csv(\`http://localhost:5050/\${endpoint}\`).then(data => {
            console.log(data)
            setState(data)
            // If there's a limit specified, slice the data to that limit
        })
    }, [])
    ...
}
            `.trim()}
        </CodeBlock>
    </div>

    <div class="text-sm-2">
    <CodeBlock lang="javascript" height="75px">
        { `
<DataAnalysisTable endpoint="data-analysis" client:only />
            `.trim()}
        </CodeBlock>
    </div>

</Slide>

<Slide>
    <div class="text-sm-2">
        <CodeBlock  lang="javascript" height="575px">
            { "    " + `
    ....

    if (state.length > 0) {
        // Get the keys (column names) by look at the first object in the data set:
        const keys = Object.keys(state[0])

        return (
            <div>
                <h1>CSV Data Fetch</h1>

                <table>
                    <thead>
                        <tr>
                            { /* Header row of column names: */ }
                            { keys.map((k, i) => <th>{ k }</th>) }
                        </tr>
                    </thead>
                    <tbody>
                        { state.map(
                            /* For each row, pull out fields according to the headers: */
                            (row, i) => <tr key={ i }>
                                { keys.map(k => <td>{ row[k] }</td>) }
                            </tr>
                        ) }
                    </tbody>
                </table>
            </div>
        )
    } else {
        return <div>State is empty</div>
    }
}
            `.trim()}
        </CodeBlock>
    </div>`
</Slide>

<Slide t2="Data Analysis: Grouping">
    <ul class="text-sm-2">
        <li class="fragment">Remove non-numeric columns</li>
        <li class="fragment">Group by the <code>Category</code> column</li>
        <li class="fragment">Apply <code>sum()</code> to the
            remaining <code>Time Spent (s)</code> column</li>

    </ul>

    <div class="text-sm-2 fragment">
        <CodeBlock lang="python" height="150px">
            { `
# Read everything:
UPLOADED_DATA = pd.read_csv("Synthetic_Digital_Traces_Dataset.csv")
# Retain just two columns:
TRIMMED_DATA = UPLOADED_DATA[["Category", "Time Spent (s)"]]
# Let's look at the first few rows:
TRIMMED_DATA.head()
`.trim()
            }
        </CodeBlock>
    </div>

    <div class="text-sm-2 fragment">
        <CodeBlock lang="python" height="150px">
            { `
@app.route("/data-analysis")
@cross_origin(origin="*")
def data_analysis():
        output = io.StringIO()
        TRIMMED_DATA.groupby("Category").sum().to_csv(output, index=True)
        return output.getvalue()
`.trim()
            }
        </CodeBlock>
    </div>
</Slide>

<Slide t2="Wrap">
    <ul>
        <li class="fragment">Look at the table of the data which is generated</li>
        <li class="fragment">Use the (updated) D3 component to visualise as a donut chart</li>
        <ul><li class="fragment">(Make sure the index and value fields have matching names)</li></ul>
        <li class="fragment">Can you summarise over other columns? What about mean calculations?</li>
        <li class="fragment">Can you clean up the number formatting (e.g. hours/mins/secs)?</li>
    </ul>
</Slide>

<Slide t2="Data Table and Donut">
    <div class="flex justify-center items-center">
        <Image
            src={ donut_final }
            alt="Final Donut Plot"
            height="500"
            width="400" />
    </div>
</Slide>
