---
// From: https://stackoverflow.com/questions/30861845/how-to-use-two-column-layout-with-reveal-js
// DEPRECATED: now using Tailwind CSS columns-2.
---
<div class="multi-col">
    <slot />
</div>

<style>
    .multi-col {
        display: table;
        table-layout: fixed; /* don't fudge depending on content */
        width: 100%;
        text-align: left; /* matter of taste, makes imho sense */
        
        .col {
            display: table-cell;
            vertical-align: top;
            width: 50%;
            padding: 2% 0 2% 3%; /* some vertical, and between columns */
            &:first-of-type { padding-left: 0; } /* there's nothing before col1 */
        }
    }
</style>
