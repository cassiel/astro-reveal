---
import BreadcrumbFooter from "@components/BreadcrumbFooter.jsx"
import "@styles/tailwind.css"
const { BASE_URL } = import.meta.env

interface Props {
	title: string,
	mathjax?: boolean
}

const { title, mathjax = false } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href=`${BASE_URL}/slides-template/favicon.svg` />
		<meta name="generator" content={Astro.generator} />

		{ mathjax &&
			<script is:inline type="text/javascript" id="MathJax-script" async
				src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js">
			</script>
		}

		<title>{title}</title>
	</head>

	<body>
		<main class="reveal">
			<div class="slides">
				<slot />
			</div>
			<BreadcrumbFooter client:only />
		</main>

		<script>
		import Reveal from "reveal.js"
		import Markdown from "reveal.js/plugin/markdown"
		import RevealHighlight from "reveal.js/plugin/highlight"

		Reveal.initialize({
			transition: "none",
			history: true,		//	Maybe false for archive deployments?
			pdfSeparateFragments: false,
			slideNumber: "c/t",
			display: "block !important",	// Override Tailwind v4 [hidden] { display: none !important } in @layer base
				// progress: false,
				// controls: false,
				autoAnimateDuration: 0.5,
				autoAnimateEasing: "cubic-bezier(0.4, 0, 0.2, 1)",
				plugins: [Markdown, RevealHighlight]
			})
		</script>
	</body>
</html>

<style is:global lang="scss">
	@import "reveal.js/reveal.css";
	@import "reveal.js/theme/night.css";
	@import "@styles/highlightjs-theme-vs2015.css";
	@reference "../styles/tailwind.css";

	/* Tailwind v4 preflight has [hidden] { display: none !important } in @layer base.
	   Reveal.js sets hidden attr on non-current sections for accessibility, but
	   expects to control display via CSS/JS. These overrides have higher specificity
	   within the same layer, so they win over Tailwind's rule. */
	@layer base {
		.reveal.overview .slides section[hidden] {
			display: block !important;
		}

		html.reveal-print .reveal .slides section[hidden] {
			display: block !important;
		}

		@media print {
			.reveal .slides section[hidden] {
				display: block !important;
			}
		}
	}

	/*  Tailwind does bring in more indirection (to its extension machinery in
		tailwind.config.mjs) - I'm not 100% convinced that's a win when we have
		Astro components to give us modularity, but will go with it - at least
		partially. (Sure enough, the styling below is a bit of a mess.) */

	/*  No obvious way to route these fonts into the Astro/Reveal submodule,
		so for now we'll expect them in the client's public folder. */

	@layer base {
		@font-face {
			font-family: 'Microgramma';
			src: url('/assets/fonts/microgramma/M025094D.ttf') format('truetype');
			font-weight: normal;
			font-style: normal;
		}

		@font-face {
			font-family: 'Microgramma';
			src: url('/assets/fonts/microgramma/Microgramma D Extended Bold.otf') format('opentype');
			font-weight: bold;
			font-style: normal;
		}

		@font-face {
			font-family: 'Open Sans';
			src: url('/assets/fonts/open-sans/OpenSans-Regular.ttf') format('truetype');
			font-weight: normal;
			font-style: normal;
		}

		@font-face {
			font-family: 'Open Sans';
			src: url('/assets/fonts/open-sans/OpenSans-Italic.ttf') format('truetype');
			font-weight: normal;
			font-style: italic;
		}

		@font-face {
			font-family: 'Open Sans';
			src: url('/assets/fonts/open-sans/OpenSans-Bold.ttf') format('truetype');
			font-weight: bold;
			font-style: normal;
		}

		@font-face {
			font-family: 'Open Sans';
			src: url('/assets/fonts/open-sans/OpenSans-BoldItalic.ttf') format('truetype');
			font-weight: bold;
			font-style: italic;
		}
	}
	
	main, .slide-background-content {
		//background: linear-gradient(#133055, #0c1a2a);
		background: linear-gradient(hsl(200, 15%, 15%),
									hsl(200, 15%, 30%));
	}

	.reveal {
		@apply font-body;

		h1, h2, h3 {
			@apply font-display;
		}

		h1 {
			@apply text-orange font-semibold;
			font-size: 2em;
		}

		h2, h3, dt {
			@apply text-yellow;
		}

		h2 {
			font-size: 1.75em;
		}

		h3 {
			font-size: 1.5em;
		}

		h4 {
			@apply font-body;
			font-weight: 600;
			font-size: 1.125em;
		}

		a:hover {
			@apply underline;
		}
	}

	code {
		@apply text-blue text-sm-1;
	}

	em {
		color: hsl(40, 60%, 55%);
	}

	footer.nav {
		@apply text-lg;
		position: absolute;
		bottom: 25px;
		left: 25px;
		z-index: 500;
		color: hsl(0, 0%, 80%);
	}

</style>
